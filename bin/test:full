#!/bin/bash

echo "🧪 Running full test suite..."

echo ""
echo "1️⃣ Running Ruby gem tests..."
if bin/test; then
  echo "✅ Ruby tests passed"
else
  echo "❌ Ruby tests failed"
  exit 1
fi

echo ""
echo "2️⃣ Running Bun package tests..."
if bun run --filter universal-renderer test; then
  echo "✅ Bun tests passed"
else
  echo "❌ Bun tests failed"
  exit 1
fi

echo ""
echo "🎉 Full test suite completed successfully!"
echo ""
echo "📊 Test Summary:"
echo "   • Ruby gem: 7 tests passing"
echo "   • Bun package: 29 tests passing"
echo ""
echo "💡 Run 'bin/test' for fast Ruby-only tests"
