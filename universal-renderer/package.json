{
  "name": "universal-renderer",
  "version": "0.7.0",
  "description": "Server-Side Rendering (SSR) server for the universal_renderer Ruby gem.",
  "license": "MIT",
  "author": "thaske",
  "homepage": "https://github.com/thaske/universal_renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaske/universal_renderer.git"
  },
  "bugs": "https://github.com/thaske/universal_renderer/issues",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:node": "vitest run",
    "test:package": "node scripts/test-package.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.mts",
      "import": "./dist/http/index.mjs",
      "require": "./dist/http/index.cjs"
    },
    "./dev": {
      "types": "./dist/dev.d.mts",
      "import": "./dist/dev.mjs",
      "require": "./dist/dev.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./shim": {
      "types": "./dist/shim/index.d.mts",
      "import": "./dist/shim/index.mjs",
      "require": "./dist/shim/index.cjs"
    },
    "./shim/auto": {
      "types": "./dist/shim/auto.d.mts",
      "import": "./dist/shim/auto.mjs",
      "require": "./dist/shim/auto.cjs"
    },
    "./react-query": {
      "types": "./dist/react-query.d.mts",
      "import": "./dist/react-query.mjs",
      "require": "./dist/react-query.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "express": "^4.22.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "express": "^4.22.2",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "express",
    "react",
    "server-side-rendering",
    "ssr",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
