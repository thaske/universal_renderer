{
  "name": "universal-renderer",
  "version": "0.5.0",
  "description": "Server-Side Rendering (SSR) server for the universal_renderer Ruby gem.",
  "license": "MIT",
  "author": "thaske",
  "homepage": "https://github.com/thaske/universal_renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaske/universal_renderer.git"
  },
  "bugs": "https://github.com/thaske/universal_renderer/issues",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:node": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.mts",
      "import": "./dist/http/index.mjs",
      "require": "./dist/http/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio/index.d.mts",
      "import": "./dist/stdio/index.mjs",
      "require": "./dist/stdio/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "express": "^4.22.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^6.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.11",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "express": "^4.22.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.11.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "express",
    "react",
    "server-side-rendering",
    "ssr",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  }
}